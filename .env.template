# CFEdgeChat environment variable key list.
# This file lists key names only — no real values.
#
# Wrangler doesn't read .env itself: for local dev, copy these keys into
# .dev.vars (wrangler dev loads it automatically; it's already gitignored).
# In deployed environments, set secrets with `wrangler secret put <NAME>` —
# never write them to a file. Non-secret config (e.g. APP_ORIGINS) can live
# in wrangler.toml's [vars] block.

# ---- Required, no default (missing or under 32 chars returns 500; see src/index.ts) ----
# Production: wrangler secret put EDGE_CHAT_JWT_SECRET
# Local dev: put in .dev.vars, must exactly match CycleUni-BE's EDGE_CHAT_JWT_SECRET
EDGE_CHAT_JWT_SECRET=

# ---- Optional (feature degrades gracefully if unset, not startup-blocking) ----
# Webhook called on new/offline messages to CycleUni-BE; local default
# http://127.0.0.1:8000/api/v1/messaging/webhook/edge-chat/
DJANGO_WEBHOOK_URL=
# X-Webhook-Secret sent with DJANGO_WEBHOOK_URL calls, must exactly match
# CycleUni-BE's EDGE_CHAT_WEBHOOK_SECRET. If unset, Django rejects the
# webhook with 403 (offline recipients won't get preview/unread sync).
DJANGO_WEBHOOK_SECRET=
# Allowed frontend origins (comma-separated), e.g.
# https://cycleuni.example.com,https://staging.cycleuni.example.com.
# Required in production; if missing, the Worker refuses to serve CORS
# headers (returns 500) unless ENVIRONMENT=development.
APP_ORIGINS=
# Set to "development" for local dev only (in .dev.vars). Only then does the
# Worker fall back to wildcard ("*") CORS when APP_ORIGINS is unset. Must not
# be set in production.
ENVIRONMENT=
